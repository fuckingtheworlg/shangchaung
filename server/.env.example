# 服务监听端口
PORT=3000

# 数据库连接（与 deploy/docker-compose.yml 中的设置保持一致）
DATABASE_URL="mysql://shangchaun:shangchaun_pwd@127.0.0.1:3306/shangchaun"

# JWT 密钥（生产环境请改成长随机字符串）
JWT_SECRET="please-change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# 单管理员账号（首次启动会自动写入数据库的 admin 表，修改后重启生效）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# 文件上传目录（相对 server/ 根）
UPLOAD_DIR="uploads"

# 对外访问图片的 URL 前缀（与 Nginx /uploads 映射一致）
# 开发期：http://localhost:3000/uploads
# 上线后：http://1.117.64.57/uploads 或备案后的 https://your-domain/uploads
PUBLIC_BASE_URL="http://localhost:3000"
