# 由 install.sh 自动渲染并复制到 /etc/nginx/conf.d/shangchaun.conf
# 占位符：@@APP_DIR@@
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 1024m;     # 单次上传上限，与后端 multer 一致
    client_body_timeout 600s;       # 大文件上传放宽到 10 分钟
    server_tokens off;

    # 1. 后台管理（React SPA, base 设为 /admin/）
    location /admin/ {
        alias @@APP_DIR@@/admin/dist/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # 兼容裸路径：访问根目录跳转到 /admin/
    location = / {
        return 302 /admin/;
    }

    # 2. 后端 API
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;    # 大文件直接流式转发给后端，不在 nginx 落盘
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 3. 用户上传的图片（Nginx 直接走静态，比 Node 高效）
    location /uploads/ {
        alias @@APP_DIR@@/server/uploads/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # 4. 健康检查
    location /health {
        proxy_pass http://127.0.0.1:3000;
        access_log off;
    }
}

