page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #222;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
  font-size: 26rpx;
}
