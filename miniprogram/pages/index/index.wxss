.card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card:active {
  background: #fafafa;
}

/* 大封面：横向占满卡片，按 4:3 比例显示，aspectFill 裁剪填满 */
.cover {
  width: 100%;
  height: 0;
  padding-bottom: 75%; /* 4:3 */
  background: #eee;
  position: relative;
}

.cover image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 无封面时，仍然显示标题区域，且不占空白图 */
.card.no-cover .cover {
  display: none;
}

.info {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

.time {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
