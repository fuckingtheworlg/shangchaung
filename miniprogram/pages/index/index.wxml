<view class="container">
  <block wx:if="{{list.length === 0 && !loading}}">
    <view class="empty">暂无内容</view>
  </block>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card {{item.cover ? '' : 'no-cover'}}"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <view class="cover" wx:if="{{item.cover}}">
      <image src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" />
    </view>
    <view class="info">
      <view class="title">{{item.title}}</view>
      <view class="time">{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="loading">— 已经到底了 —</view>
</view>
