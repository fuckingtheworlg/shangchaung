<view class="container">
  <block wx:if="{{list.length === 0 && !loading}}">
    <view class="empty">暂无内容</view>
  </block>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="card"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <image
      wx:if="{{item.cover}}"
      class="cover"
      src="{{item.cover}}"
      mode="aspectFill"
      lazy-load="{{true}}"
      style="width:{{coverWidth}}rpx;height:{{coverHeight}}rpx;"
    />
    <view class="info">
      <view class="title">{{item.title}}</view>
      <view class="time">{{item.createdAt}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{finished && list.length > 0}}" class="loading">— 已经到底了 —</view>
</view>
