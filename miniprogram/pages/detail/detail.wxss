.container {
  background: #fff;
  padding: 32rpx;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #222;
  margin-bottom: 16rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.cover {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  background: #eee;
}

.content {
  font-size: 30rpx;
  line-height: 1.7;
  color: #333;
  word-break: break-word;
}

/* rich-text 内的图片自适应宽度，rich-text 的内联样式需在富文本 HTML 里写，
   也可以由编辑器统一注入。这里靠 wangEditor 默认行为已经处理大部分。 */
